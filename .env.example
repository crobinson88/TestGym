VITE_SUPABASE_URL=https://rgslyxzeyjiypzilpxpf.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_rKWA3iD6cb-2zCUuubeBJQ_kZB1mO_Z

# Server-only — used by Vercel functions (api/fireflies-import.ts, api/receipt-scan.ts,
# api/stock-summarize.ts).
# NEVER prefix these with VITE_ (that bundles them into the client) and never commit real values.
SUPABASE_URL=https://rgslyxzeyjiypzilpxpf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Google Gemini key for api/door-assess.ts (door installation vision check).
# Get one at https://aistudio.google.com/apikey.
# GOOGLE_API_KEY and Google_Studio_API_Key are also accepted.
GEMINI_API_KEY=
FIREFLIES_API_KEY=
# Optional — User-Agent the stock-summarizer sends when fetching filing URLs (SEC asks for one).
RESEARCH_USER_AGENT=
# Used by api/reading-digest.ts to email the "read this week" reading list.
# RESEND_FROM must be a verified Resend sender, e.g. "Reading <reading@yourdomain.com>".
RESEND_API_KEY=
RESEND_FROM=
# Google service account for the TDL "Add Calendar" flow (calendar-sync action
# on api/fireflies-import.ts).
# Create a service account in Google Cloud, enable the Calendar API, and grant it
# domain-wide delegation for the calendar.events scope so it can write to the
# user's Workspace calendar. Paste the private key with literal \n for newlines.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Optional overrides — both default to charlie@theglassmarket.co.
# GOOGLE_CALENDAR_SUBJECT is the user impersonated via delegation;
# GOOGLE_CALENDAR_ID is the calendar events are written to.
GOOGLE_CALENDAR_SUBJECT=
GOOGLE_CALENDAR_ID=
